{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pusaka (Port 1922 - Default)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--web-port",
        "1922",
        "--web-hostname",
        "0.0.0.0"
      ]
    },
    {
      "name": "Pusaka Web (Chrome - Port 1922)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--web-port",
        "1922",
        "--web-hostname",
        "0.0.0.0"
      ]
    },
    {
      "name": "Pusaka Web Server (LAN 0.0.0.0:1922)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "web-server",
        "--web-port",
        "1922",
        "--web-hostname",
        "0.0.0.0"
      ]
    }
  ]
