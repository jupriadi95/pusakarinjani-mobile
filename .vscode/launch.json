{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pusaka (Auto Detect / Android / Desktop)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "Pusaka Web (Chrome - Port 1922 & LAN)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--web-port",
        "1922",
        "--web-hostname",
        "0.0.0.0"
      ]
    },
    {
      "name": "Pusaka Web Server (Port 1922 & LAN)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "web-server",
        "--web-port",
        "1922",
        "--web-hostname",
        "0.0.0.0"
      ]
    },
    {
      "name": "Pusaka Android (Target Device)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "android"
      ]
    }
  ]
}

