<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP traffic across all local and remote endpoints -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Explicitly whitelist local static DNS domain and LAN targets -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">be-local.pusakarinjani.my.id</domain>
        <domain includeSubdomains="true">pusakarinjani.my.id</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
